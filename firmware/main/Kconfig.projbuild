menu "Addison Weather"
    config WEATHER_WIFI_SSID
        string "Wi-Fi SSID (2.4 GHz)"
        default "your-ssid"
    config WEATHER_WIFI_PASSWORD
        string "Wi-Fi password"
        default "your-password"
    config WEATHER_IMAGE_URL
        string "URL of weather.bin"
        default "https://YOUR-GITHUB-USER.github.io/addison-weather/weather.bin"
    config WEATHER_REFRESH_MINUTES
        int "Minutes between updates"
        default 60
    config WEATHER_RETRY_MINUTES
        int "Minutes before retry after a failed update"
        default 15
endmenu
